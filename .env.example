# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Supabase → Connect → "Session pooler" connection string, with your database password
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Cloudflare Turnstile. These are Cloudflare's public TEST keys (always pass);
# replace with your real keys from the Cloudflare dashboard before going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: public contact email shown on /privacy and /terms
NEXT_PUBLIC_CONTACT_EMAIL=

# Random string; Vercel Cron sends it to /api/cron/daily (set in Vercel, Production)
CRON_SECRET=
